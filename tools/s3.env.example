# Скопируй в tools/s3.env (он в .gitignore) и заполни.
# Ключи — те же, что s3_access_key/s3_secret_key в lmify/selectel/terraform.tfvars
# (они проектные: бакет lmify-models живёт в проекте LMIFY).
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Куда класть кэш Кристины. Тот же адрес — s3_cache_uri в
# kristina/selectel/terraform.tfvars.
KRISTINA_S3_CACHE=s3://lmify-models/kristina-cache

#S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
#S3_REGION=ru-7
