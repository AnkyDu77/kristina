# Скопируй в .env и заполни. .env в .gitignore — секреты не коммитим.

# ── Сборка docker-образа бота ──────────────────────────────────────
# Версия terraform в контейнере — та же, что на хосте (`terraform version`):
# старший terraform пишет state, который младший прочесть откажется
#TF_VERSION=1.14.3

# ── Telegram ───────────────────────────────────────────────────────
# Токен от @BotFather
KRISTINA_TG_BOT_TOKEN=
# Кому Кристина отвечает (tg_id через запятую). Остальных молча игнорирует.
KRISTINA_ALLOWED_TGIDS=123456789
# Кто может будить (/wake, кнопка «Разбудить») и гасить (/sleep) видеокарту —
# это деньги. Должны быть и в KRISTINA_ALLOWED_TGIDS. Сообщения карту не
# будят: пока она спит, вопросы копятся и потом отвечаются одним заходом.
KRISTINA_GPU_ADMIN_TGIDS=123456789

# ── «Мозг» ────────────────────────────────────────────────────────
# По умолчанию LLM живёт на той же GPU, что голос и кружки (llmster,
# модель — llm_model_path в selectel/terraform.tfvars): ничего задавать
# не надо, адрес, ключ и модель бот узнает сам.
# Внешний OpenAI-совместимый эндпоинт (lmify, API) — тогда со своим ключом:
#KRISTINA_LLM_BASE=http://1.2.3.4:8080/v1
#KRISTINA_LLM_KEY=
# Ключ модели; пусто — бот спросит у сервера, какая загружена
#KRISTINA_LLM_MODEL=

# ── Агент ──────────────────────────────────────────────────────────
# Сколько раз модель может сходить в инструменты за один ответ
#KRISTINA_AGENT_MAX_STEPS=6
# Сколько ждать ✅/❌ на действие с последствиями (запомнить, забыть)
#KRISTINA_APPROVAL_TIMEOUT=10m
# Часовой пояс для «сегодня» в промпте
#KRISTINA_TZ=Europe/Moscow
# История, память, подтверждения, отложенные вопросы, задачи, мониторы (sqlite)
#KRISTINA_DB=data/kristina.db
# Потолок вызовов инструментов у фоновой задачи
#KRISTINA_TASK_MAX_STEPS=25
# Мониторы страниц: интервал по умолчанию и не чаще чем
#KRISTINA_MONITOR_DEFAULT=1h
#KRISTINA_MONITOR_MIN=10m

# ── Компьютер Кристины ─────────────────────────────────────────────
# Рабочая папка (присланные файлы — в inbox/)
#KRISTINA_WORKSPACE=data/workspace
# Песочница для run_command: auto (если есть докер и образ) | docker (обязательна) | off
#KRISTINA_SANDBOX=auto
#KRISTINA_SANDBOX_IMAGE=kristina-sandbox:local
# none — без сети (по умолчанию). Иначе (bridge) — каждая команда с ✅
#KRISTINA_SANDBOX_NETWORK=none
#KRISTINA_SANDBOX_MEMORY=1g
#KRISTINA_SANDBOX_CPUS=1
# Путь workspace на хосте — если бот в контейнере (docker-compose.yml задаёт сам)
#KRISTINA_SANDBOX_HOST_DIR=
# Браузер на GPU-машине (Playwright MCP): 0 — выключить
#KRISTINA_BROWSER=1
# Браузер где-то ещё (тогда карта ему не нужна)
#KRISTINA_BROWSER_URL=
# Внешние MCP-серверы: имя=адрес через запятую; ключ — KRISTINA_MCP_TOKEN_<ИМЯ>
#KRISTINA_MCP_SERVERS=docs=https://example.com/mcp
#KRISTINA_MCP_TOKEN_DOCS=

# ── Медиа-API на GPU VPS (TTS + lip-sync) ──────────────────────────
# Bearer-ключ — из api_keys в selectel/terraform.tfvars
KRISTINA_MEDIA_KEY=
# managed-режим (по умолчанию): бот сам делает terraform apply/destroy
#KRISTINA_TF_DIR=../selectel
#KRISTINA_TF_BIN=terraform
# Через сколько простоя гасить машину
#KRISTINA_GPU_IDLE=20m
# статический режим: машина поднята руками — terraform бот не трогает
#KRISTINA_MEDIA_BASE=http://1.2.3.4:8080

# ── Кристина ───────────────────────────────────────────────────────
# Аватар: idle-луп (делается из фото на маке — tools/idle-loop/).
# Голое фото тоже годится, но рот будет двигаться на неподвижном лице.
#KRISTINA_AVATAR=../assets/idle.mp4
# Здесь живёт голос: data/voice/ref.wav + ref.txt (их создаёт /design → /keep)
#KRISTINA_DATA_DIR=data
#KRISTINA_LANGUAGE=Russian
# Потолок речи в кружке, символов (~600 ≈ 40 секунд)
#KRISTINA_MAX_SPEECH=600
#KRISTINA_HISTORY_TURNS=12
# Кружок — только за «крупную» задачу: от стольких вызовов инструментов.
# 0 — кружки только по /circle
#KRISTINA_CIRCLE_MIN_TOOLS=3
#KRISTINA_CIRCLE_SIDE=512
